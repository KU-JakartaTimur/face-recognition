# Contoh konfigurasi face-recognition API.
#
# CATATAN PENTING: main.py membaca environment variable asli lewat os.getenv()
# dan TIDAK memuat file ini sendiri (tidak ada python-dotenv di requirements).
# Jadi file ini dipakai lewat salah satu cara berikut:
#
#   docker run --env-file .env ...
#   docker compose  ->  env_file: .env
#   systemd         ->  EnvironmentFile=/path/.env
#
# Kalau dijalankan langsung dengan "python main.py" atau "uvicorn main:app",
# export dulu variabelnya secara manual (atau pasang python-dotenv).
#
# Semua nilai di bawah ini SAMA dengan default di main.py, jadi aman disalin
# apa adanya: cukup ubah yang perlu.
#
#   cp .env.example .env

# --- Penyimpanan -----------------------------------------------------------

# Folder berisi foto master wajah terdaftar (nama file = nama orang).
# Default di main.py: <folder main.py>/writable/faces
# Nilai di bawah mengikuti Dockerfile; mount sebagai volume agar tidak hilang
# saat container dibuat ulang.
KNOWN_FACES_DIR=/app/writable/faces

# --- Ambang pencocokan wajah ----------------------------------------------

# Jarak euclidean maksimum agar dua encoding dianggap orang yang sama
# (default dlib). Dipakai HANYA di /verify-face untuk memutuskan match.
# Turunkan kalau sering salah kenal, naikkan kalau wajah sah sering ditolak.
FACE_TOLERANCE=0.6

# Ambang khusus deteksi duplikat lintas-nama di /catch-face. Sengaja lebih
# ketat dari FACE_TOLERANCE: pada foto berkualitas rendah (wajah kecil di
# frame, blur, backlight, masker), jarak 0.45-0.6 lebih sering berarti dua
# orang BERBEDA daripada duplikat -- itu penyebab pendaftaran sah ditolak 409.
# Response 409 memuat "distance" dan "matched_name" untuk menyetel angka ini:
# masih ada false positive -> turunkan ke 0.40; duplikat asli lolos -> naikkan
# bertahap.
DUP_TOLERANCE=0.45

# --- Kualitas encoding -----------------------------------------------------

# Model landmark untuk meluruskan wajah sebelum di-encode:
#   large = 68 titik (lebih akurat), small = 5 titik (lebih cepat)
# Nilainya dipakai untuk foto master DAN probe /verify-face sekaligus, jadi
# kalau diubah, restart service atau panggil POST /reload-faces supaya seluruh
# encoding master dihitung ulang dengan model yang sama. Master dan probe yang
# beda model menghasilkan chip tidak sebangun dan semua jarak ikut melar.
FACE_ENCODE_MODEL=large

# Berapa kali foto MASTER di-encode ulang dengan perturbasi lalu dirata-ratakan.
# Makin tinggi makin stabil tapi makin lambat. Hanya berlaku saat pendaftaran
# dan saat scan folder; probe /verify-face selalu 1 agar absensi tidak melambat.
# Turunkan ke 1 kalau startup terlalu lama karena wajah terdaftar sudah banyak.
FACE_ENCODE_JITTERS=10

# --- Batas request ---------------------------------------------------------

# Batas ukuran gambar setelah decode base64; lebih dari ini ditolak 413
# sebelum di-decode. Default 8 MB.
MAX_IMAGE_BYTES=8388608

# Sisi terpanjang gambar sebelum deteksi wajah. Gambar lebih besar dikecilkan
# dulu supaya face_locations() (jalan di CPU) tidak menahan worker.
MAX_DETECT_SIZE=1600

# --- Lain-lain -------------------------------------------------------------

# Zona waktu container (sudah diset di Dockerfile, di sini untuk override).
TZ=Asia/Jakarta
